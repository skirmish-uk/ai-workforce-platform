# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_workforce?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# Model Providers (configure as needed)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Voice agents (docs/VOICE.md). OPENAI_API_KEY covers speech-to-text and the default text-to-speech.
SPEECH_STT_PROVIDER="openai"
SPEECH_TTS_PROVIDER="openai"   # or "cartesia"
CARTESIA_API_KEY=""
CARTESIA_VOICE_ID=""

# Email (for notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@aiworkforce.local"

# Storage (for file uploads)
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""

# Feature Flags
ENABLE_OPENAI=true
ENABLE_ANTHROPIC=true
ENABLE_WEB_BROWSING=false

# Agent safety controls (packages/executor/src/safety.ts). Read by the worker process.
# Platform-wide kill switch: every agent run and every approved action is refused while true.
AGENTS_DISABLED=false
# Comma-separated tool names revoked platform-wide, e.g. "gmail__send_email,google-drive__delete_file".
DISABLED_TOOLS=""

# Database used by `npm test` in packages/executor (must be a *_test database; tests create and delete rows).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_workforce_test?schema=public"

# Encrypts integration credentials at rest (AES-256-GCM). Generate: openssl rand -base64 32
# Rotation: move the old key to CREDENTIALS_ENCRYPTION_KEY_PREVIOUS, set a new one, run scripts/encrypt-credentials.ts --apply
CREDENTIALS_ENCRYPTION_KEY=""
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=""
