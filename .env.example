# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_workforce?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# Model Providers (configure as needed)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Voice agents (docs/VOICE.md). OPENAI_API_KEY covers speech-to-text and the default text-to-speech.
SPEECH_STT_PROVIDER="openai"   # or "deepgram" / "speechmatics" (an agent can override: voice.sttProvider)
# Optional speech-to-text providers, to compare on the agent page ("Compare transcribers")
DEEPGRAM_API_KEY=""
SPEECHMATICS_API_KEY=""
SPEECH_TTS_PROVIDER="openai"   # or "cartesia"
CARTESIA_API_KEY=""
CARTESIA_VOICE_ID=""
# Monthly cap on Cartesia speech (characters, all tenants; 1 credit each, ~780 a minute). Default 100000; 0 = no cap.
# Per tenant: Tenant.settings.voiceLimits = { "monthlyCharacters": 50000, "clonesPerMonth": 10 } (the defaults).
CARTESIA_MONTHLY_CHARACTER_LIMIT=""

# Email (for notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=""                # empty = implicit TLS on port 465 only, STARTTLS otherwise
APP_URL=""                    # Dashboard link in emails; empty = NEXTAUTH_URL
EMAIL_FROM="noreply@aiworkforce.local"  # From address for approval emails (SMTP_HOST empty = email off)

# Storage (for file uploads)
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""

# Feature Flags
ENABLE_OPENAI=true
ENABLE_ANTHROPIC=true
ENABLE_WEB_BROWSING=false

# Agent safety controls (packages/executor/src/safety.ts). Read by the worker process.
# Platform-wide kill switch: every agent run and every approved action is refused while true.
AGENTS_DISABLED=false
# Comma-separated tool names revoked platform-wide, e.g. "gmail__send_email,google-drive__delete_file".
DISABLED_TOOLS=""

# Database used by `npm test` in packages/executor (must be a *_test database; tests create and delete rows).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_workforce_test?schema=public"

# Encrypts integration credentials at rest (AES-256-GCM). Generate: openssl rand -base64 32
# Rotation: move the old key to CREDENTIALS_ENCRYPTION_KEY_PREVIOUS, set a new one, run scripts/encrypt-credentials.ts --apply
CREDENTIALS_ENCRYPTION_KEY=""
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=""

# "Connect Google" (Gmail + Google Calendar), see docs/GOOGLE_CONNECT.md. OAuth client of type
# "Web application" from Google Cloud. Leave GOOGLE_REDIRECT_URI empty to use
# $NEXTAUTH_URL/api/integrations/google/callback (follows the ngrok URL when sharing a demo).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Any other mailbox over IMAP/SMTP is connected on the Integrations page (docs/EMAIL_CONNECT.md).
# true lets it reach a local test server (private addresses, any port, self-signed certificates);
# ignored when NODE_ENV=production. Only for scripts/email-live-test.ts and local trials.
EMAIL_ALLOW_LOCAL_SERVERS=""
