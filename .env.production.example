# Copy to .env.production on the server (chmod 600). Read by compose.prod.yml for both
# variable substitution (DOMAIN, POSTGRES_PASSWORD) and the app containers' environment.
DOMAIN=example.com
POSTGRES_PASSWORD=        # openssl rand -hex 24
NEXTAUTH_SECRET=          # openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=   # openssl rand -base64 32 (back it up: losing it means reconnecting every integration)
# Site-wide password in front of the whole app (apps/web/src/middleware.ts). Strongly recommended:
# the demo logins are public in the repo and the app spends real API credit.
SITE_USERNAME=demo
SITE_PASSWORD=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Approval emails (packages/executor/src/notifications). Leave SMTP_HOST empty to keep email off.
# The demo users are @*.local and are never mailed; add a real address to an admin user or to
# Tenant.settings.notifications.approvalRecipients to receive them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
