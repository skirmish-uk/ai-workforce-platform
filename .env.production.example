# Copy to .env.production on the server (chmod 600). Read by compose.prod.yml for both
# variable substitution (DOMAIN, POSTGRES_PASSWORD) and the app containers' environment.
DOMAIN=example.com
POSTGRES_PASSWORD=        # openssl rand -hex 24
NEXTAUTH_SECRET=          # openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=   # openssl rand -base64 32 (back it up: losing it means reconnecting every integration)
# Site-wide password in front of the whole app (apps/web/src/middleware.ts). Strongly recommended:
# the demo logins are public in the repo and the app spends real API credit.
SITE_USERNAME=demo
SITE_PASSWORD=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional speech-to-text providers to compare with OpenAI on an agent page ("Compare transcribers").
DEEPGRAM_API_KEY=
SPEECHMATICS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Approval emails (packages/executor/src/notifications). Leave SMTP_HOST empty to keep email off.
# The demo users are @*.local and are never mailed; add a real address to an admin user or to
# Tenant.settings.notifications.approvalRecipients to receive them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Monthly cap on Cartesia speech (characters, all tenants; 1 credit each, ~780 a minute). Default 100000; 0 = no cap.
# Per tenant: Tenant.settings.voiceLimits = { "monthlyCharacters": 50000, "clonesPerMonth": 10 } (the defaults).
CARTESIA_MONTHLY_CHARACTER_LIMIT=""

# Backups and alerts (docs/DEPLOY.md "Backups and alerts"). Nightly at BACKUP_HOUR_UTC (16 = 3 am
# Sydney in daylight saving), kept BACKUP_KEEP_DAYS days in the `backups` volume.
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=16
# Where alerts go (site down, backup missed, a new kind of server error): an ntfy topic URL
# (e.g. https://ntfy.sh/<a long random topic>, then subscribe in the ntfy app), a Slack incoming
# webhook or a Discord webhook. Empty: alerts are only logged (scripts/demo-deploy.sh backup-logs).
ALERT_WEBHOOK_URL=
