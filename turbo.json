{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "lint": {},
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {},
    "db:push": {},
    "db:migrate": {},
    "db:studio": {}
  },
  "globalEnv": ["DATABASE_URL", "NEXTAUTH_SECRET", "REDIS_URL", "TEST_DATABASE_URL"]
}